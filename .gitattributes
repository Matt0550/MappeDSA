# Keep line endings stable (LF) so the "Update recent posts" Action only commits
# real content changes — never phantom CRLF/LF diffs.
*.html text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.xml  text eol=lf
*.json text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# Binary assets — git must never normalize these
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.webp binary
